	},
	"tokenColors": [
		{
			"settings": { "foreground": "#1a1a1a" }
		},
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#8a8a8a", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#7a5a1e" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#1a1a1a" }
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#a3392c" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": { "foreground": "#7a52b8" }
		},
		{
			"scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
			"settings": { "foreground": "#8a6512" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#2e7a4f" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#1a1a1a" }
		},
		{
			"scope": ["variable", "variable.parameter"],
			"settings": { "foreground": "#1a1a1a" }
		},
		{
			"scope": ["variable.other.constant", "variable.other.readwrite.alias"],
			"settings": { "foreground": "#1a1a1a" }
		},
		{
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#666666" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "foreground": "#8a6512", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.heading"],
			"settings": { "foreground": "#1a1a1a", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#2e7a4f" }
		},
		{
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#a3392c" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#a3392c" }
		}
	]
}
