	},
	"tokenColors": [
		{
			"settings": { "foreground": "#e0e0e0" }
		},
		{
			"scope": ["comment", "punctuation.definition.comment"],
			"settings": { "foreground": "#6e6e6e", "fontStyle": "italic" }
		},
		{
			"scope": ["string", "string.quoted"],
			"settings": { "foreground": "#f0c896" }
		},
		{
			"scope": ["constant.numeric", "constant.language", "constant.character"],
			"settings": { "foreground": "#f2f2f2" }
		},
		{
			"scope": ["keyword", "storage.type", "storage.modifier", "keyword.control"],
			"settings": { "foreground": "#f47067" }
		},
		{
			"scope": ["entity.name.function", "support.function", "meta.function-call"],
			"settings": { "foreground": "#dcbdfb" }
		},
		{
			"scope": ["entity.name.class", "entity.name.type", "support.class", "support.type"],
			"settings": { "foreground": "#daaa3f" }
		},
		{
			"scope": ["entity.name.tag"],
			"settings": { "foreground": "#8ddb8c" }
		},
		{
			"scope": ["entity.other.attribute-name"],
			"settings": { "foreground": "#f2f2f2" }
		},
		{
			"scope": ["variable", "variable.parameter"],
			"settings": { "foreground": "#e0e0e0" }
		},
		{
			"scope": ["variable.other.constant", "variable.other.readwrite.alias"],
			"settings": { "foreground": "#f2f2f2" }
		},
		{
			"scope": ["punctuation", "meta.brace"],
			"settings": { "foreground": "#949494" }
		},
		{
			"scope": ["markup.bold"],
			"settings": { "foreground": "#daaa3f", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.italic"],
			"settings": { "fontStyle": "italic" }
		},
		{
			"scope": ["markup.heading"],
			"settings": { "foreground": "#d4d4d4", "fontStyle": "bold" }
		},
		{
			"scope": ["markup.inserted"],
			"settings": { "foreground": "#8ddb8c" }
		},
		{
			"scope": ["markup.deleted"],
			"settings": { "foreground": "#ff938a" }
		},
		{
			"scope": ["invalid", "invalid.illegal"],
			"settings": { "foreground": "#ff938a" }
		}
	]
}
